# Nama aplikasi yang ditampilkan oleh Laravel.
APP_NAME=Laravel
# Lingkungan aplikasi; gunakan local saat pengembangan.
APP_ENV=local
# Kunci enkripsi aplikasi; isi dengan php artisan key:generate.
APP_KEY=
# Aktifkan detail error hanya untuk lingkungan pengembangan.
APP_DEBUG=true
# Alamat dasar aplikasi untuk membentuk URL.
APP_URL=http://localhost

# Bahasa utama aplikasi.
APP_LOCALE=en
# Bahasa cadangan jika terjemahan utama tidak tersedia.
APP_FALLBACK_LOCALE=en
# Bahasa data palsu yang dibuat oleh factory.
APP_FAKER_LOCALE=en_US

# Cara aplikasi mengelola mode pemeliharaan.
APP_MAINTENANCE_DRIVER=file
# Gunakan baris berikut bila status pemeliharaan disimpan di database.
# APP_MAINTENANCE_STORE=database

# Jumlah worker PHP untuk server development bawaan.
PHP_CLI_SERVER_WORKERS=4

# Tingkat cost hashing password; nilai lebih tinggi biasanya membutuhkan proses lebih lama.
BCRYPT_ROUNDS=12

# Tujuan utama penulisan log aplikasi.
LOG_CHANNEL=stack
# Channel yang digunakan oleh channel log bertumpuk.
LOG_STACK=single
# Channel khusus untuk pesan deprecation, jika diaktifkan.
LOG_DEPRECATIONS_CHANNEL=null
# Tingkat pesan minimum yang ditulis ke log.
LOG_LEVEL=debug

# Jenis database yang digunakan aplikasi.
DB_CONNECTION=sqlite
# Alamat server database jika menggunakan MySQL atau PostgreSQL.
# DB_HOST=127.0.0.1
# Port server database jika menggunakan MySQL atau PostgreSQL.
# DB_PORT=3306
# Nama database yang digunakan jika tidak memakai SQLite.
# DB_DATABASE=laravel
# Username untuk masuk ke server database.
# DB_USERNAME=root
# Password untuk masuk ke server database.
# DB_PASSWORD=

# Tempat penyimpanan sesi login; konfigurasi ini membutuhkan tabel sessions.
SESSION_DRIVER=database
# Lama sesi login berlaku dalam menit.
SESSION_LIFETIME=120
# Menentukan apakah isi sesi dienkripsi.
SESSION_ENCRYPT=false
# Path cookie sesi pada domain.
SESSION_PATH=/
# Domain cookie sesi; null berarti memakai domain saat ini.
SESSION_DOMAIN=null

# Tujuan koneksi untuk fitur broadcast.
BROADCAST_CONNECTION=log
# Disk penyimpanan file bawaan Laravel.
FILESYSTEM_DISK=local
# Tempat penyimpanan antrean pekerjaan background.
QUEUE_CONNECTION=database

# Tempat penyimpanan data cache; database membutuhkan tabel cache.
CACHE_STORE=database
# Prefix tambahan untuk nama key cache, bila diperlukan.
# CACHE_PREFIX=

# Alamat server Memcached jika cache Memcached digunakan.
MEMCACHED_HOST=127.0.0.1

# Library client yang digunakan untuk terhubung ke Redis.
REDIS_CLIENT=phpredis
# Alamat server Redis.
REDIS_HOST=127.0.0.1
# Password Redis; null jika server tidak memakai password.
REDIS_PASSWORD=null
# Port koneksi Redis.
REDIS_PORT=6379

# Mailer log mencatat email ke log, bukan mengirim email sungguhan.
MAIL_MAILER=log
# Skema koneksi mail jika diperlukan.
MAIL_SCHEME=null
# Alamat server SMTP jika memakai mailer SMTP.
MAIL_HOST=127.0.0.1
# Port server SMTP.
MAIL_PORT=2525
# Username autentikasi SMTP jika diperlukan.
MAIL_USERNAME=null
# Password autentikasi SMTP jika diperlukan.
MAIL_PASSWORD=null
# Alamat pengirim email.
MAIL_FROM_ADDRESS="hello@example.com"
# Nama pengirim email, mengikuti nama aplikasi.
MAIL_FROM_NAME="${APP_NAME}"

# Access key untuk layanan penyimpanan AWS, jika digunakan.
AWS_ACCESS_KEY_ID=
# Secret key untuk layanan penyimpanan AWS, jika digunakan.
AWS_SECRET_ACCESS_KEY=
# Region layanan AWS.
AWS_DEFAULT_REGION=us-east-1
# Nama bucket penyimpanan AWS.
AWS_BUCKET=
# Mengatur penggunaan endpoint bergaya path pada AWS.
AWS_USE_PATH_STYLE_ENDPOINT=false

# Nama aplikasi yang diteruskan ke proses build Vite.
VITE_APP_NAME="${APP_NAME}"
